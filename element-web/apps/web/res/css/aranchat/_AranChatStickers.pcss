/* AranChat — แผงเลือกสติกเกอร์ (src/aranchat/AranStickerPicker.tsx) */
.mx_AranStickers {
    width: 344px;
    height: 380px;
    display: flex;
    flex-direction: column;
    background: var(--cpd-color-bg-canvas-default);
    border-radius: 16px;
    overflow: hidden;
}
.mx_AranStickers_title {
    padding: 10px 14px 6px;
    font: var(--cpd-font-body-sm-semibold);
    color: var(--cpd-color-text-secondary);
}
.mx_AranStickers_grid {
    flex: 1;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 4px 8px 10px;
    align-content: start;
}
.mx_AranStickers_item {
    border: 0;
    background: none;
    padding: 4px;
    border-radius: 12px;
    cursor: pointer;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.08s ease, background-color 0.1s;

    img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    &:hover,
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-secondary);
    }
    &:active {
        transform: scale(0.92);
    }
}
/* แท็บชุดสติกเกอร์ด้านล่าง (แบบ LINE) */
.mx_AranStickers_tabs {
    display: flex;
    gap: 2px;
    padding: 4px 6px;
    overflow-x: auto;
    border-top: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-subtle-secondary);
}
.mx_AranStickers_tab {
    flex: none;
    width: 44px;
    height: 40px;
    border: 0;
    border-radius: 10px;
    background: none;
    cursor: pointer;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }
    &[aria-selected="true"] {
        opacity: 1;
        background: var(--cpd-color-bg-canvas-default);
        box-shadow: inset 0 -3px 0 #5b3fd9;
    }
}
.mx_AranStickers_empty {
    grid-column: 1 / -1;
    padding: 40px 0;
    text-align: center;
    color: var(--cpd-color-text-secondary);
}
/* จอแคบ: กว้างเต็มจอ */
@media (max-width: 480px) {
    .mx_AranStickers {
        width: calc(100vw - 16px);
    }
}
