# แบรนด์ของแอปมือถือ (องค์กรละโฟลเดอร์: aranchat/brands/<ชื่อ>/) — สร้างใหม่: ./aranchat/new-brand.sh <ชื่อ>
# build: ./aranchat/build-brand.sh <ชื่อ>  → aranchat/out/<APP_NAME>-<ชื่อ>-<เวอร์ชัน>.apk
# APP_ID เปลี่ยนแล้วถือเป็นแอปใหม่ (Play Store / เครื่องผู้ใช้) — ตั้งครั้งเดียวแล้วอย่าเปลี่ยน
APP_ID=com.arankub.aranchat
APP_NAME=AranChat
# เซิร์ฟเวอร์ที่แอปเข้าได้ (ล็อกไว้ ผู้ใช้ไม่ต้องพิมพ์) — server_name ของ Matrix + URL ของ homeserver
SERVER_NAME=arankub.com
HOMESERVER_URL=https://matrix.arankub.com
# client_uri ของแอปตอน login (OAuth) — APP_ID ต้องขึ้นต้นด้วยโดเมนนี้กลับด้าน (arankub.com → com.arankub.…)
# ไม่งั้นระบบ login (MAS) ไม่ยอมรับ redirect กลับเข้าแอป
WEBSITE_URL=https://arankub.com
# เว็บแชทของหน่วยงาน — หน้าดาวน์โหลด/เช็กอัปเดต (https://<CHAT_HOST>/download/latest.json) + ลิงก์ชวนเพื่อน /i/<รหัส>
CHAT_HOST=chat.arankub.com
LOGO_URL=https://chat.arankub.com/branding/icon-512.png
# ข้อตกลงการใช้งาน / นโยบายความเป็นส่วนตัว — ระบบ login (MAS) บังคับให้อยู่โดเมนเดียวกับ WEBSITE_URL
# ไม่งั้นแอปล็อกอินไม่ได้ ("client registration denied by the policy")
TERMS_URL=https://arankub.com/terms
PRIVACY_URL=https://arankub.com/privacy
# สีหลัก (ปุ่ม/ลิงก์ในแอป)
BRAND_COLOR=#5B3FD9
# push gateway ของเราเอง (Sygnal ใน aranchat-ess: scripts/16-push.sh) — ว่าง = ใช้ค่าเริ่มต้นของแอป
PUSH_GATEWAY_URL=https://matrix.arankub.com/_matrix/push/v1/notify
# app id ที่ลงทะเบียนกับ push gateway (ต้องตรงกับ config ของ Sygnal)
PUSHER_APP_ID=com.arankub.aranchat.android
# ฝากกุญแจกู้คืนแชทเข้ารหัสที่ server หน่วยงาน (aranchat-ess/scripts/21-keyvault.sh) — ว่าง = ไม่ใช้
KEYVAULT_URL=https://chat.arankub.com/api/keyvault
# สีพื้นหลังไอคอน (adaptive icon ของ Android — เห็นตอนระบบตัดขอบไอคอน)
LAUNCHER_BG=#4C2FC9
