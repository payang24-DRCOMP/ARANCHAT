# คัดลอกเป็น .env (chmod 600) — ห้าม commit / ห้ามวางในแชท
# ── Plan-D ───────────────────────────────────────────────────────────
PLAND_URL=https://pland.mipble.com
# ความลับตรวจลายเซ็น — ผู้ดูแล Plan-D ได้ตอนเพิ่มปลายทาง https://chat.arankub.com/api/pland/webhook
# (ตั้งค่า → แอปภายนอก → แอปนี้ → แจ้งเหตุการณ์) · แสดงครั้งเดียว
PLAND_WEBHOOK_SECRET=
# บัญชีบริการ (confidential client) — ใช้อ่านรายละเอียด ชื่อผู้ลา/ห้อง/เวลา · ไม่ตั้ง = แจ้งเตือนแบบสั้น
# บทบาทที่ต้องมี: hr.leave.read (+hr.leave.read.team) · hr.travel.read (+hr.travel.read.team) · bookings.read (+bookings.read.details) · meetings.read · asset.registry.read
PLAND_SERVICE_CLIENT_ID=
PLAND_SERVICE_CLIENT_SECRET=
# แอปสำหรับ "เชื่อมบัญชี" รายบุคคล (/pland) — ผู้ดูแลสร้างแอปภายนอก (public client ก็ได้)
#   Redirect URI: https://chat.arankub.com/api/pland/callback (ตรงทุกตัวอักษร)
#   scope: openid profile hr.personnel.read hr.leave.read
# แอปเดียวกันนี้ใช้เพิ่มปลายทาง webhook ได้เลย
PLAND_CLIENT_ID=
# มีเฉพาะถ้าสร้างเป็น confidential client
PLAND_CLIENT_SECRET=
# เฉพาะโหมดทดสอบ --listen (หน่วยทดลองใช้)
PLAND_DEV_TOKEN=

# ── AranChat ─────────────────────────────────────────────────────────
# key ของระบบ "Plan-D" (สร้างจากหน้าจัดการแจ้งเตือนใน AranKub → ระบบที่ส่งแจ้งเตือน)
ARANCHAT_KEY=
ARANCHAT_URL=https://chat.arankub.com/api/notify
PUBLIC_BIND=10.42.0.1:3213

# ── ปลายทาง (ไม่ตั้ง = ห้องตั้งต้น · ตั้งเป็นค่าว่าง = ผู้รับประจำในหน้าจัดการ · ใส่ได้หลายที่คั่นด้วย , เช่น room:pland-vehicle,arankub:12)
#LEAVE_TO=room:pland-leave
#TRAVEL_TO=room:pland-travel
#REPAIR_TO=room:pland-repair
#ROOM_TO=room:pland-meeting-room
#VEHICLE_TO=room:pland-vehicle
#BOOKING_TO=room:pland-meeting-room
#MEETING_TO=room:pland-meeting
#DOC_TO=room:pland-saraban
# on = แสดงประเภทการลา (ลาป่วย/ลาพักผ่อน) ในห้อง — ห้องแจ้งเตือนไม่เข้ารหัส
#LEAVE_SHOW_TYPE=on
# เรื่องไหน/จังหวะไหน ส่งถึงเจ้าตัว / ห้องกลุ่มงาน / ห้องตามเรื่อง → ดู routes.mjs · ปรับได้ด้วยไฟล์ routes.json
# ห้องกลุ่มงาน สร้างเองอัตโนมัติ (off = ปิด)
#UNIT_ROOMS=on
# Plan-D ยังไม่เปิด API แจ้งซ่อม/หนังสือเข้า — เปิดเมื่อไหร่ใส่พาธ แล้วแจ้งรายคน+กลุ่มงานทำงานเอง
#REPAIR_DETAIL_PATH=/asset-maintenance
#DOC_DETAIL_PATH=/correspondence

# ── แจ้งเตือนรายบุคคล (personal.mjs) ───────────────────────────────────
# ที่อยู่สาธารณะของ bridge (ลิงก์เชื่อมบัญชี + redirect URI = <PUBLIC_URL>/callback)
#PUBLIC_URL=https://chat.arankub.com/api/pland
# AranChat เรียกคำสั่ง /pland มาที่นี่ (ในเครื่อง) — bridge ลงทะเบียน webhook + คำสั่งให้เองตอนเริ่ม
#HOOK_BIND=127.0.0.1:3213
# ใบลาใหม่ถึงหัวหน้ารายคน (คนที่เปิด "/pland ทีม")
#TEAM_EVENTS=leave.submit
